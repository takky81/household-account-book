# Vite は VITE_ で始まる変数だけをフロントエンドに露出する。
# ここに書くのは公開前提のキー。実際の権限は Supabase 側の RLS が決める。
# キーの呼び名は anon key から publishable key に変わった。
# VITE_SUPABASE_PUBLISHABLE_KEY でも VITE_SUPABASE_ANON_KEY でも読む。

# ローカル開発（npx supabase start で立ち上げたもの）
# 値は `npx supabase status` で確認する
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=

# 本番は Supabase のプロジェクト設定 > API から取得し、
# GitHub Actions の Variables / Secrets に入れる
